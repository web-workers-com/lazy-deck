{
  "name": "lazy-deck",
  "version": "0.5.1",
  "description": "Lazy Deck: a Stream Deck plugin with a sloth that takes over the whole deck when something needs you.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.5.1"
  },
  "scripts": {
    "prebuild-scripts": "tsc -p tsconfig.scripts.json",
    "icons": "npm run prebuild-scripts && node scripts/generate-manifest.mjs && node scripts/generate-icons.mjs",
    "profiles": "npm run prebuild-scripts && node scripts/generate-profiles.mjs",
    "build": "npm run icons && npm run profiles && rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.lazydeck.plugin\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run prebuild-scripts && node --test tests/*.test.mjs",
    "validate": "streamdeck validate com.lazydeck.plugin.sdPlugin",
    "pack": "npm run build && node scripts/pack.mjs",
    "link": "node scripts/dev-link.mjs",
    "unlink": "node scripts/dev-link.mjs --unlink",
    "preview": "npm run prebuild-scripts && node scripts/preview.mjs",
    "pack:ci": "rollup -c && node scripts/pack.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.4",
    "@elgato/utils": "^0.6.2"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.4",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/node": "^22.10.0",
    "rollup": "^4.28.0",
    "sharp": "^0.35.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
